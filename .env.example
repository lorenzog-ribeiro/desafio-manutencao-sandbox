# ========================================================
# Variáveis de Ambiente para Deploy no Dokploy
# ========================================================

# Banco de dados PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=triage_db

# GitHub API Token (com escopo 'repo')
GITHUB_TOKEN=ghp_seu_personal_access_token_aqui

# Google Gemini API Key (opcional se quiser usar IA ao vivo)
GEMINI_API_KEY=AIzaSy_sua_chave_gemini_aqui

# Segredo do Webhook do GitHub (opcional)
GITHUB_WEBHOOK_SECRET=

# Porta do Host para o Frontend (porta 80 já é usada pelo Traefik/Dokploy)
FRONTEND_PORT=3000
